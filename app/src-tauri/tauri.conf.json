{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImgSwitch",
  "version": "0.1.0",
  "identifier": "com.imgswitch.desktop",
  "build": {
    "frontendDist": "../../imgswitch/gui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ImgSwitch",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Image backends for Claude Code",
    "longDescription": "Choose which image backend Claude Code uses (OpenAI-compatible APIs, Stable Diffusion WebUI, ComfyUI, Unsloth Studio), generate and edit images, and browse everything ImgSwitch made.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
